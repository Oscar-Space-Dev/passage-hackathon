# Les secrets restent sur votre machine. Ne pas commiter .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DUST_API_KEY=
DUST_WORKSPACE_ID=
DUST_BASE_URL=https://dust.tt
PIPELEX_API_KEY=
PIPELEX_METHOD_REF=
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
# Base persistante externe pour l'aperçu Render Free (optionnelle en local).
# Utiliser l'URL affichée par Turso : libsql:// (Cloud libSQL) ou turso:// (TursoDB).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Clé Fernet stable entre redémarrages : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSAGE_ENCRYPTION_KEY=
# URL exacte ouverte dans le navigateur (retour OAuth des MCP officiels)
PASSAGE_PUBLIC_URL=http://127.0.0.1:8088
# Connexion Google à Passage (client OAuth Web, redirect_uri : /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Moteur local ou API compatible Chat Completions
COMPATIBLE_BASE_URL=http://localhost:11434/v1
COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
PASSAGE_OSCAR=demo
OSCAR_URL=http://127.0.0.1:8000
OSCAR_TOKEN=
OSCAR_COMPANY=1
OSCAR_MCP_SCRIPT=
